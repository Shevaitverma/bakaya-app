{
  "expo": {
    "name": "Bakaya",
    "slug": "bakaya",
    "version": "1.0.0",
    "scheme": [
      "bakaya",
      "com.bakaya.app"
    ],
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android"
    ],
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.bakaya.app"
    },
    "android": {
      "package": "com.bakaya.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#D81B60"
      },
      "usesCleartextTraffic": true,
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-splash-screen",
      "expo-web-browser",
      "expo-notifications",
      "@react-native-google-signin/google-signin"
    ]
  }
}
